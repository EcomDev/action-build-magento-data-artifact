{
  "name": "action-build-magento-data-artifact",
  "private": true,
  "version": "2.0.0",
  "license": "Apache-2.0",
  "author": "Ivan Chepurnyi",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "bundle:main": "esbuild ./src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.cjs --sourcemap --minify --keep-names",
    "bundle:build-init": "esbuild ./src/build-init/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/build-init.cjs --sourcemap --minify --keep-names",
    "bundle:build-create-project": "esbuild ./src/build-create-project/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/build-create-project.cjs --sourcemap --minify --keep-names",
    "bundle:build-install": "esbuild ./src/build-install/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/build-install.cjs --sourcemap --minify --keep-names",
    "bundle:build-exec": "esbuild ./src/build-exec/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/build-exec.cjs --sourcemap --minify --keep-names",
    "bundle:build-reindex": "esbuild ./src/build-reindex/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/build-reindex.cjs --sourcemap --minify --keep-names",
    "bundle:build-dump": "esbuild ./src/build-dump/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/build-dump.cjs --sourcemap --minify --keep-names",
    "bundle:build-artifact": "esbuild ./src/build-artifact/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/build-artifact.cjs --sourcemap --minify --keep-names",
    "bundle": "npm run bundle:main && npm run bundle:build-init && npm run bundle:build-create-project && npm run bundle:build-install && npm run bundle:build-exec && npm run bundle:build-reindex && npm run bundle:build-dump && npm run bundle:build-artifact",
    "test": "vitest run",
    "format": "prettier --write ./src",
    "license": "generate-license-file --input package.json --output dist/licenses.txt --overwrite --ci --no-spinner --eol lf",
    "build": "npm run bundle && npm run license"
  },
  "dependencies": {
    "@actions/artifact": "^6.3.1",
    "@actions/cache": "^6.2.0",
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/http-client": "^4.0.1",
    "@actions/io": "^3.0.2",
    "semver": "^7.8.6"
  },
  "devDependencies": {
    "@github/local-action": "^7.0.1",
    "@types/node": "^26.0",
    "@types/semver": "^7.8.0",
    "esbuild": "^0.28.2",
    "generate-license-file": "^4.2.5",
    "memfs": "^4.80.0",
    "msw": "^3.0.4",
    "prettier": "3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
