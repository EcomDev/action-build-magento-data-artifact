{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "newLine": "lf",
    "outDir": "./lib",
    "rootDir": "./src",
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "useUnknownInCatchVariables": false,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts"
  ]
}