INPUT_MARIADB-VERSION=11.8
INPUT_PHP-VERSION=8.4
INPUT_OPENSEARCH-VERSION=3.0
INPUT_MAGENTO-VERSION=2.4.9
INPUT_SAMPLE-DATA=true
INPUT_NAME=2.4.9-sampledata
# Example of configuration value
INPUT_SETTINGS={"catalog/price/scope":"1"}
INPUT_REPOSITORY=https://repo.magento.com/
# Place here your composer repo settings in format:
# {"http-basic":{"repo.magento.com":{"username":"USER","password":"PASSWORD"}}}
INPUT_AUTH={}
# Place here your github token if you want to auto-setup it for magento install
INPUT_TOKEN=
GITHUB_WORKSPACE=./build
# Specify absolute path this directory
LOCAL_ACTION_WORKSPACE=/full/path/to/build
# Specify absolute path this directory
LOCAL_ACTION_ARTIFACT_PATH=
# Specify absolute path to this directory
LOCAL_ACTION_CACHE_PATH=